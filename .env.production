# 生产环境配置 - 量化交易平台
# Production Environment Configuration - Quant Trading Platform

# API Configuration
NEXT_PUBLIC_API_URL=https://your-production-api-domain.com
NEXT_PUBLIC_NODE_ENV=production

# Database Configuration (Production)
DATABASE_URL=sqlite:///./quant_trading_production.db
REDIS_URL=redis://your-redis-host:6379

# Security Configuration (Production - CHANGE THESE VALUES)
SECRET_KEY=your-production-secret-key-change-this-immediately
CORS_ORIGINS=https://your-frontend-domain.com

# Sentry APM Configuration (Production)
SENTRY_DSN=https://fbe88d262e5a5ea00c46bffa1517ce73@o4508931649699840.ingest.de.sentry.io/4510465825177680
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTRY_DEBUG=false

# Frontend Sentry Configuration (Production)
NEXT_PUBLIC_SENTRY_DSN=https://7fb207cac6b27f8e87f551f8767055c1@o4508931649699840.ingest.de.sentry.io/4510465805975632
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DEBUG=false

# API Configuration (Production)
API_REQUEST_TIMEOUT=60
MAX_REQUESTS_PER_MINUTE=1000

# Logging Configuration (Production)
LOG_LEVEL=WARNING
LOG_FORMAT=json
STRUCTURED_LOGGING=true

# Performance Configuration (Production)
STRATEGY_TIMEOUT=60
MAX_CALCULATION_PERIODS=5000

# Feature Flags (Production)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Security Configuration (Production)
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS_PROTECTION=true

# Monitoring and Health Checks
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PERFORMANCE_MONITORING=true