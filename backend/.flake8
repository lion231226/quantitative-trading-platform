S616 = # 不推荐使用低安全性zipfile调用
S617 = # 不推荐使用低安全性tarfile调用
S618 = # 不推荐使用不安全的URL打开
S619 = # 不推荐使用低安全性multiprocessing
S620 = # 不推荐使用低安全性字典
S621 = # 不推荐使用不安全的元组解包
S622 = # 不推荐使用不安全的循环变量
S623 = # 不推荐使用不安全的循环变量

# flake8-print
T001 = # 不推荐使用print语句
T002 = # 不推荐使用pprint
T003 = # 不推荐使用print函数

# pyupgrade
UP001 = # 使用unicode literals
UP002 = # 使用super()
UP003 = # 使用list comprehensions
UP004 = # 使用replaced
UP005 = # 使用format()
UP006 = # 使用f-strings
UP007 = # 使用utf-8编码
UP008 = # 使用super()
UP009 = # 使用utf-8编码
UP010 = # 使用utf-8编码
UP011 = # 使用utf-8编码
UP012 = # 使用utf-8编码

# per-file-ignores
[per-file-ignores]
__init__.py = F401
tests/* = S101, S311, S608
conftest.py = S101
migrations/* = S101, S608