# 前端生产环境配置 - 量化交易平台
# Frontend Production Configuration - Quant Trading Platform

# API Configuration (Production)
NEXT_PUBLIC_API_URL=https://your-production-api-domain.com
NEXT_PUBLIC_NODE_ENV=production

# Sentry Error and Performance Monitoring (Production)
NEXT_PUBLIC_SENTRY_DSN=https://7fb207cac6b27f8e87f551f8767055c1@o4508931649699840.ingest.de.sentry.io/4510465805975632
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DEBUG=false

# Application Information (Production)
NEXT_PUBLIC_APP_NAME=量化交易单均线策略分析平台
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags (Production)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Security Configuration (Production)
NEXT_PUBLIC_CSRF_SECRET=your-production-csrf-secret

# Build Configuration (Production)
NEXT_TELEMETRY_DISABLED=1
ANALYZE=true

# Deployment Environment
VERCEL_ENV=production

# Security Headers and Protection
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS_PROTECTION=true