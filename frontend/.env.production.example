# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Sentry Configuration for Performance Monitoring
# Get your DSN from: https://sentry.io/settings/projects/your-project/keys/
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Application Information
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_COMMIT_SHA=your-commit-hash

# API Configuration
NEXT_PUBLIC_API_URL=https://your-production-api.com

# Performance Monitoring Settings
# Sentry sampling rates (adjust based on your needs)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Disable debug logging in production
NODE_ENV=production