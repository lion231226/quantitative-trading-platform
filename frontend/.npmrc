# Security Configuration
# Enable package-lock generation
package-lock=true

# Enable strict SSL
strict-ssl=true

# Security audit settings
audit=true
audit-level=moderate

# Prevent execution of scripts during installation
ignore-scripts=false

# Registry configuration
registry=https://registry.npmjs.org/

# Cache configuration for security
cache=/tmp/.npm

# Prevent dependency tampering
send-metrics=false

# Timeout settings for security
fetch-timeout=60000
fetch-retry-mintimeout=20000

# Limit concurrent requests for security
fetch-retry-maxtimeout=120000

# Disable automatic updates of peer dependencies
auto-install-peers=true

# Enforce strict peer dependencies
strict-peer-deps=true

# Security headers for HTTP requests
user-agent=npm/8.0.0 node/v18.0.0 win32 x64

# Prevent potential security issues
prefer-offline=false
prefer-online=true

# Cache security
maxsockets=50

# Prevent path traversal attacks
prefix=~/.npm-global

# Protect against malicious packages
allow-same-version=false

# Script execution control
engine-strict=true

# Prevent man-in-the-middle attacks
cafile=

# HTTP proxy settings (if needed)
# proxy=
# https-proxy=