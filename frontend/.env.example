# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NODE_ENV=development

# Database Configuration (if needed)
# DATABASE_URL=

# Authentication (if applicable)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# Third-party APIs (if applicable)
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# Build Configuration
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# Deployment Environment
# VERCEL_URL=
# VERCEL_ENV=

# Security Configuration
# Snyk Security Scanning
SNYK_TOKEN=your-snyk-token-here
SNYK_ORG=your-organization-name

# Security Headers and Protection
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS_PROTECTION=true

# Encryption and Security Keys
NEXT_PUBLIC_CSRF_SECRET=your-csrf-secret
JWT_SECRET=your-jwt-secret-for-development
ENCRYPTION_KEY=your-32-character-encryption-key

# Security Monitoring
SECURITY_WEBHOOK_URL=your-security-webhook-url
SECURITY_ALERT_EMAIL=admin@example.com

# Sentry Error and Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/1234568
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DEBUG=false

# Enable Error Reporting and Analytics
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true