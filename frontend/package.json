{
  "name": "quant-trading-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:cygwin": "/c/Program\\ Files/nodejs/node.exe ./node_modules/.bin/jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report",
    "build:prod": "npm run build",
    "build:analyze": "ANALYZE=true npm run build",
    "security:audit": "node ../scripts/security-audit.js",
    "security:audit:fix": "npm audit fix && node ../scripts/security-audit.js --auto-fix",
    "security:check": "node ../scripts/security-audit.js --no-report",
    "precommit:security": "node ../scripts/security-audit.js --no-fail",
    "security:monitor": "npm audit --audit-level moderate",
    "deps:check": "node ../scripts/dependency-updater.js",
    "deps:update": "node ../scripts/dependency-updater.js --update-security",
    "deps:plan": "node ../scripts/dependency-updater.js --no-report",
    "deps:security": "npm audit && npm update",
    "snyk:install": "npm install -g snyk",
    "snyk:auth": "snyk auth",
    "snyk:test": "node ../scripts/snyk-scanner.js",
    "snyk:monitor": "node ../scripts/snyk-scanner.js --monitor",
    "snyk:license": "snyk license",
    "security:snyk": "node ../scripts/snyk-scanner.js --configure --monitor",
    "security:full": "npm run security:audit && npm run snyk:test",
    "deps:hardening": "node ../scripts/dependency-hardening.js",
    "deps:lock": "npm install --package-lock-only",
    "security:hardening": "npm run deps:hardening && npm run security:audit",
    "security:complete": "npm run deps:hardening && npm run security:audit && npm run snyk:test"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.0.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@sentry/react": "^10.27.0",
    "@sentry/tracing": "^7.120.4",
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.2",
    "chart.js": "^4.4.2",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.0.9",
    "lodash": "^4.17.21",
    "lucide-react": "^0.552.0",
    "next": "^14.2.33",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/semver": "^7.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.19",
    "cors": "^2.8.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^3.0.1",
    "happy-dom": "^14.12.3",
    "helmet": "^8.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "semver": "^7.5.4",
    "zod": "^3.22.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.6"
}
