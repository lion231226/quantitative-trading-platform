# 前端环境变量
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=量化交易单均线策略分析平台
NEXT_PUBLIC_APP_VERSION=1.0.0

# 后端环境变量
DATABASE_URL=sqlite:///./quant_trading.db
REDIS_URL=redis://localhost:6379

# API配置
AKSHARE_CACHE_TTL=86400
MAX_RETRY_ATTEMPTS=3

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 开发配置
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# 性能配置
API_REQUEST_TIMEOUT=30
MAX_REQUESTS_PER_MINUTE=100

# 策略配置
STRATEGY_TIMEOUT=30
MAX_CALCULATION_PERIODS=1000

# 监控和可观测性配置
# Sentry APM配置
SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/1234567
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_DEBUG=false

# 前端Sentry配置
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o123456.ingest.sentry.io/1234568
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# 日志配置
LOG_FORMAT=json
STRUCTURED_LOGGING=true